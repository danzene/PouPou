# Copie para .env e ajuste. Todos têm padrão sensato no código.

# Caminho do banco SQLite (relativo à raiz do projeto) — usado quando NÃO há DATABASE_URL.
DB_PATH=dados/precos.db

# Postgres do Supabase. Se SETADA, o app e os coletores usam o Postgres em vez do SQLite.
# Pegue em Supabase → Project Settings → Database → Connection string (URI).
# NUNCA comite este valor (ele tem a senha do banco). Fica só no seu .env local / no host.
# Em servidor SERVERLESS (Vercel), use a porta 6543 (pooler de TRANSAÇÃO) em vez da 5432.
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-...pooler.supabase.com:6543/postgres

# --- Mercado Pago (pagamentos) — setar no host (Fly/Vercel secrets), NUNCA comitar ---
# MP_ACCESS_TOKEN=APP_USR-...      (SECRETO — credencial de produção da sua aplicação MP)
# MP_WEBHOOK_SECRET=...            (SECRETO — assinatura secreta do webhook, do painel MP)
# PUBLIC_BASE_URL=https://seu-app.vercel.app   (público — base das back_urls e do webhook)

# Supabase (públicos — já têm padrão embutido no código; só setar se trocar de projeto):
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# Pacing: delay mínimo (segundos) entre requisições ao MESMO domínio. Padrão >= 1s.
DELAY_SEGUNDOS=1.2

# Timeout de cada requisição HTTP (segundos)
TIMEOUT_SEGUNDOS=20

# Quantos produtos no máximo puxar por termo-semente (paginação VTEX vai em janelas de 50)
MAX_POR_TERMO=50

# E-mail de contato exposto no header (coleta identificável e responsável)
CONTATO=magezene.dl@gmail.com

# Mercados VIP Commerce (Enxuto, Dalben): o token é GERADO AUTOMATICAMENTE pelo coletor
# (login público da loja). Você NÃO precisa configurar nada aqui.
# Só use as vars abaixo se quiser SOBRESCREVER o token manualmente (debug), ou trocar a
# credencial da plataforma caso ela mude:
#   VIP_LOJA_KEY=...        (chave da plataforma; padrão embutido no coletor)
#   VIP_ENXUTO_TOKEN=...    (força um token específico p/ a Enxuto)
#   VIP_DALBEN_TOKEN=...    (força um token específico p/ o Dalben)
